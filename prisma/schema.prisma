generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model ConnectedAccount {
  id             String    @id @default(cuid())
  platform       String
  platformId     String?
  name           String?
  username       String?
  encryptedToken String?
  category       String?
  status         String?
  owner          String?
  connectedOn    DateTime  @default(now())
  updatedAt      DateTime?
  lastSyncedAt   DateTime?
  nameStatus     String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@unique([platform, platformId, owner])
  @@index([owner, connectedOn])
  @@index([platform, platformId])
  @@map("connected_accounts")
}

model Post {
  id               String   @id @default(cuid())
  postCollectionId String?
  accountId        String?
  platform         String?
  platformPostId   String?
  message          String?
  postLink         String?
  createdBy        String?
  createdOn        DateTime @default(now())
  analytics        Json?
  logs             String[] @default([])
  mediaUrls        String[] @default([])

  @@index([accountId, createdOn])
  @@index([postCollectionId])
  @@index([platformPostId])
  @@map("posts")
}

model PostCollection {
  id                       String    @id @default(cuid())
  content                  String
  mediaUrls                String[]  @default([])
  status                   String
  author                   String?
  createdAt                DateTime  @default(now())
  postsId                  String[]  @default([])
  accountIds               String[]  @default([])
  platforms                String[]  @default([])
  ctaType                  String?
  ctaLink                  String?
  publishedAt              DateTime?
  scheduledAt              DateTime?
  originalPostCollectionId String?

  @@index([status, createdAt])
  @@map("post_collections")
}

model Upload {
  id          String   @id @default(cuid())
  contentName String?
  fileName    String
  fileSize    Int
  fileType    String
  uploadedBy  String
  filePath    String
  platform    String
  contentId   String
  uploadedOn  DateTime @default(now())

  @@index([uploadedOn])
  @@index([fileName])
  @@map("uploads")
}

model SyncLog {
  id           String   @id @default(cuid())
  accountId    String
  status       String
  syncedAt     DateTime @default(now())
  postsSynced  Int?
  errorMessage String?
  range        Json?
  details      Json?

  @@index([accountId, syncedAt])
  @@map("sync_logs")
}

model SyncLogEntry {
  id         String    @id @default(cuid())
  type       String
  platform   String
  forProfile String    @map("for_profile")
  sinceTime  DateTime? @map("since_time")
  toTime     DateTime? @map("to_time")
  moreInfo   Json?     @map("moreinfo")
  createdOn  DateTime  @default(now()) @map("created_on")

  @@index([platform, forProfile, createdOn])
  @@index([type, createdOn])
  @@map("sync_log")
}

model Space {
  id     String       @id @default(cuid())
  name   String
  assets SpaceAsset[]

  @@map("space")
}

model SpaceAsset {
  id       String  @id @default(cuid())
  spaceId  String  @map("space_id")
  platform String
  assetId  String  @map("asset_id")
  account  Account @relation(fields: [assetId], references: [id], onDelete: Cascade)
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, platform, assetId])
  @@index([spaceId])
  @@index([platform, assetId])
  @@map("space_assets")
}

model Conversation {
  id            String    @id @default(cuid())
  moreDetails   Json?
  contactId     String
  contactName   String
  channelId     String
  platform      String
  lastMessage   String?
  lastMessageAt DateTime?
  unread        Boolean   @default(false)
  avatar        String?
  createdAt     DateTime  @default(now())

  @@index([channelId, contactId])
  @@index([lastMessageAt])
  @@map("conversations")
}

