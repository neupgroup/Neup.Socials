model Account {
  id           String       @id
  connectionId String
  displayName  String       @default("") @map("display_name")
  displayImage String       @default("") @map("display_image")
  neupId       String?      @map("neupid")
  type         String       @default("individual")
  createdOn    DateTime     @default(now()) @map("created_on")
  status       String       @default("active")
  moreDetails  Json?        @map("more_details")
  spaceAssets  SpaceAsset[]

  @@map("accounts")
}
